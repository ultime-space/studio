{
  "name": "@ultime/studio",
  "version": "0.2.1",
  "description": "Ultime · studio：配置器无头运行时（定义 / 状态 / 规范化 / 诊断 / 预览模型 / 导出清单），纯 TS、零依赖、不碰 DOM 与文件系统",
  "keywords": [
    "configuration",
    "configurator",
    "form-state",
    "headless",
    "json-pointer",
    "settings",
    "typescript"
  ],
  "homepage": "https://github.com/ultime-space/studio#readme",
  "bugs": {
    "url": "https://github.com/ultime-space/studio/issues"
  },
  "license": "MIT",
  "author": "Ultime contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultime-space/studio.git"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "SKILLS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test",
    "size": "size-limit --json",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "typescript": "^5.9.3",
    "unplugin-unused": "^0.6.0",
    "vite-plus": "1.5.1"
  },
  "size-limit": [
    {
      "name": "@ultime/studio",
      "path": "dist/index.js"
    }
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.6.0"
}
